{
  "_comment": "Governance hooks to merge into ~/.claude/settings.json — all paths use ~/ for portability",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/canonical-cwd-check.sh",
            "timeout": 10,
            "statusMessage": "Context Governance: verifying the canonical working copy..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/pre-session.sh",
            "timeout": 10,
            "statusMessage": "Context Governance: pre-session check..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/pr-watch-guard.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/pre-task.sh",
            "timeout": 10,
            "statusMessage": "Context Governance: pre-task check..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/plan-gate.sh",
            "timeout": 15,
            "statusMessage": "Context Governance: plan gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/parallel-import.sh",
            "timeout": 15,
            "statusMessage": "Context Governance: parallel-session import check..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/file-collision-guard.sh",
            "timeout": 15,
            "statusMessage": "Context Governance: checking for a parallel-session collision..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/governance-guard.sh",
            "timeout": 60,
            "statusMessage": "Context Governance: checking protected-doc write guard..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/pre-write.sh",
            "timeout": 10,
            "statusMessage": "Context Governance: pre-write impact map..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/pii-gate-pretooluse.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/no-local-compute.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/deny-git-bypass.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/render-gate.sh",
            "timeout": 10,
            "statusMessage": "Context Governance: render gate..."
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/cross-session-guard.sh",
            "timeout": 10,
            "statusMessage": "Context Governance: checking the cross-session message contract..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/post-milestone.sh",
            "timeout": 10,
            "statusMessage": "Context Governance: post-milestone update..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/sync-governance-copies.sh",
            "timeout": 60,
            "_timeout_note": "Raised 15 -> 60 on 2026-09-18, from a measurement, not a guess. This hook renders and PII-gates the file that was just edited; on a loaded machine (25-36 concurrent bash processes) the render+gate+copy path measured 7.4s / 7.9s / 11.1s / 15.9s -- the last one OVER the old 15s budget. A PostToolUse hook killed at its timeout leaves the live file and the publishable bundle silently DIVERGED, which is the exact failure this hook exists to prevent. Per the 2026-09-15 rule (~/.claude/CLAUDE.md), the remedy for a slow-but-correct control is a budget it can finish inside, never a watchdog: machinery that supervises machinery costs time on every run, a bigger budget costs nothing until something is genuinely slow. Same fix and same reasoning as governance-guard.sh (10 -> 60) that day.",
            "statusMessage": "Context Governance: mirroring governance files..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/file-collision-record.sh",
            "timeout": 15,
            "statusMessage": "Context Governance: recording the file state we just left..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/pr-watch-guard.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/render-rules-read.sh",
            "timeout": 10,
            "statusMessage": "Context Governance: render-rules token..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-full-finish.sh",
            "timeout": 10,
            "statusMessage": "Checking for uncommitted changes..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/check-docs-updated.sh",
            "timeout": 10,
            "statusMessage": "Checking documentation coverage..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/pre-done.sh",
            "timeout": 15,
            "statusMessage": "Context Governance: verification gate..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/sync-governance-copies.sh --sync-if-drifted",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "echo '[MEMORY MAINTENANCE] Before ending: (1) Verify MEMORY.md < 200 lines (2) No duplicate/stale memory files (3) Completed projects archived (4) Open-Problems.md updated (5) Old handoffs archived (6) All MEMORY.md + CLAUDE.md references valid.'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/end-session.sh",
            "timeout": 10,
            "statusMessage": "Context Governance: end-session handoff..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-full-finish.sh",
            "timeout": 10,
            "statusMessage": "Checking for uncommitted changes..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/selftest-advisory-stop.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/close-completeness.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/close-report.sh",
            "timeout": 90,
            "statusMessage": "Context Governance: generating the closing report from the record..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/governance/pr-watch-guard.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "effortLevel": "max"
}
